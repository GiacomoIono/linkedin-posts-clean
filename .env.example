# Local environment setup
#
# 1. Copy this file: cp .env.example .env
# 2. Add your real credentials to .env only.
# 3. Never commit .env or put real secrets in this example file.

# Required credentials
LINKEDIN_ACCESS_TOKEN=
OPENAI_API_KEY=
WEBFLOW_API_TOKEN=

# Alternative Webflow token name supported by the pipeline.
# Leave this blank when WEBFLOW_API_TOKEN is set.
WEBFLOW_READ_AND_WRITE_BLOG_POSTS=

# Normal pipeline settings
OPENAI_MODEL=gpt-5.6
WEBFLOW_COLLECTION_ID=63250855178122098387d7ef
WEBFLOW_PUBLISH=true

# Optional prompt profile selector.
# Leave blank to use the first profile in config/prompts.json.
LINKEDIN_PROMPT_PROFILE=

# Maintenance overrides. Keep false for normal runs.
FORCE_WEBFLOW_SYNC=false
